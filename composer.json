{
  "name": "byjg/shortid",
  "description": "Create short string IDs from numbers",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "ByJG\\ShortId\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.1 <8.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6|^11.5",
    "vimeo/psalm": "^5.9|^6.13"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm --threads=1"
  }
}

{
  "name": "byjg/shortid",
  "description": "Create short string IDs from numbers",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "ByJG\\ShortId\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.3 <8.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "vimeo/psalm": "^6.16"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm --threads=1"
  }
}
